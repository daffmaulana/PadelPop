# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

PORT=3000
PORTS=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=padel_reservation
DB_SSL=false

# Use a long random string (32+ characters)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Create these in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth callback URL
# Development: https://localhost:3001/auth/google/callback
# Production: https://your-railway-domain.up.railway.app/auth/google/callback
GOOGLE_CALLBACK_URL=https://localhost:3001/auth/google/callback
